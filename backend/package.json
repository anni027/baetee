{
  "name": "baetee-medusa",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "medusa develop",
    "build": "medusa build && node scripts/copy-runtime-assets.cjs",
    "start": "medusa start",
    "migrate": "medusa db:migrate && npm run migrate:refunds",
    "migrate:refunds": "node scripts/migrate-refund-ledger.cjs",
    "preflight:production": "node scripts/preflight-production.cjs",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "connect:storefront": "medusa exec ./src/scripts/connect-storefront.ts",
    "configure:razorpay": "medusa exec ./src/scripts/configure-razorpay.ts",
    "verify:catalog": "medusa exec ./src/scripts/verify-catalog.ts",
    "verify:schema": "node scripts/verify-private-schema.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test tests/*.test.ts"
  },
  "dependencies": {
    "pg": "8.23.1",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@medusajs/caching-redis": "2.21.2",
    "@medusajs/event-bus-redis": "2.21.2",
    "@medusajs/file-s3": "2.21.2",
    "@medusajs/workflow-engine-redis": "2.21.2",
    "@medusajs/locking-redis": "2.21.2",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/pg": "8.6.1",
    "@swc/core": "^1.7.28",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": { "node": "^22.12.0 || ^24.0.0" }
}
