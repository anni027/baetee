DATABASE_URL=postgres://baetee:replace-me@localhost:5432/baetee
# Local database only. For Supabase production use a private medusa schema and verified TLS.
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
JWT_SECRET=replace-with-64-random-characters
COOKIE_SECRET=replace-with-a-different-64-random-characters
MEDUSA_WORKER_MODE=shared
PORT=9000
STORE_ASSET_BASE_URL=http://localhost:3000
# Order email subscriber (server-only)
SUPABASE_URL=https://your-project.supabase.co
EMAIL_FUNCTION_TOKEN=replace-with-random-secret-shared-with-supabase
ORDER_DELIVERY_VERIFIED=false
# Razorpay (test credentials first; automatic capture must be enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
STORE_RULES_VERIFIED=false
RAZORPAY_LIVE_VERIFIED=false
PRIVACY_CONTACT_EMAIL=
# For production uploads, use a public Supabase Storage bucket with S3 access enabled:
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
