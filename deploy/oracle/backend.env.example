NODE_ENV=production
PORT=9000
MEDUSA_BACKEND_URL=https://api.example.com
STORE_ASSET_BASE_URL=https://www.example.com
STORE_CORS=https://www.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://api.example.com,https://www.example.com
# Copy the actual session-mode hostname from Supabase Connect (not transaction mode / port 6543).
# URL-encode the password; no sslmode/options query parameters (configured below).
DATABASE_URL=postgresql://baetee_medusa.PROJECT_REF:URL_ENCODED_PASSWORD@ACTUAL_SESSION_POOLER_HOST:5432/postgres
DATABASE_SCHEMA=medusa
DATABASE_SSL=true
DATABASE_CA_CERT=/run/certs/supabase-ca.crt
DATABASE_POOL_MAX=5
REDIS_URL=redis://:SAME_64_HEX_REDIS_PASSWORD@redis:6379
JWT_SECRET=GENERATE_64_HEX_CHARACTERS
COOKIE_SECRET=GENERATE_DIFFERENT_64_HEX_CHARACTERS
SUPABASE_URL=https://PROJECT_REF.supabase.co
EMAIL_FUNCTION_TOKEN=GENERATE_SHARED_RANDOM_TOKEN
PRIVACY_CONTACT_EMAIL=
S3_FILE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/baetee-products
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=baetee-products
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
STORE_RULES_VERIFIED=false
RAZORPAY_LIVE_VERIFIED=false
ORDER_DELIVERY_VERIFIED=false
